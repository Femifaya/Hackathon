{
  "name": "stock-catalyst-ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AI-assisted US stock research workbench. Evidence-based research only: no trading, no order execution, no brokerage connectivity.",
  "license": "MIT",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/core/*.test.ts",
    "test:core": "node --test tests/core/*.test.ts",
    "test:app": "vitest run",
    "test:watch": "vitest",
    "test:all": "node --test tests/core && vitest run",
    "test:coverage": "vitest run --coverage",
    "db:migrate": "node scripts/migrate.ts",
    "db:seed": "node scripts/seed-demo.ts",
    "verify:secrets": "node scripts/verify-no-secrets.ts",
    "verify": "pnpm typecheck && pnpm lint && pnpm test:core && pnpm test:app && pnpm verify:secrets && pnpm build"
  },
  "dependencies": {
    "better-sqlite3": "^12.0.0",
    "lightweight-charts": "^5.0.0",
    "next": "^15.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.0",
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitest/coverage-v8": "^3.1.0",
    "eslint": "^9.25.0",
    "eslint-config-next": "^15.5.0",
    "jsdom": "^26.0.0",
    "postcss": "^8.5.0",
    "prettier": "^3.5.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.30.0",
    "vitest": "^3.1.0"
  }
}
